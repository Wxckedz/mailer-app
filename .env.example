# ===============================================
# MAILER APP - ENVIRONMENT CONFIGURATION
# ===============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

PORT=3000
NODE_ENV=production

# Telegram bot (optional — panel works without it)
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_USERNAME=icyfeel
TELEGRAM_CHAT_ID=

# Hostinger SMTP — loaded as a shared mailbox on startup
HOSTINGER_USER=admin@312studio.in
HOSTINGER_PASS=
HOSTINGER_DOMAIN=312studio.in
