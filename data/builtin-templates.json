    ],
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Investigation Notice</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#ffffff;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;\">\n    <tr>\n      <td align=\"center\" style=\"padding:0;\">\n        <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:600px;background:#ffffff;\">\n          <tr>\n            <td align=\"center\" style=\"padding:28px 20px 18px;\">\n              <img src=\"cid:metlogo2\" alt=\"Metropolitan Police\" style=\"height:50px;margin-bottom:10px;\">\n              <h2 style=\"margin:0;color:#005ea5;\">Metropolitan Police</h2>\n            </td>\n          </tr>\n          <tr>\n            <td align=\"center\" style=\"padding:6px 24px 4px;\">\n              <h1 style=\"margin:0;font-size:24px;color:#005ea5;font-weight:bold;\">Investigation Notice</h1>\n            </td>\n          </tr>\n          <tr>\n            <td align=\"center\" style=\"padding:4px 24px 16px;\">\n              <p style=\"margin:0;font-size:15px;color:#666666;\">Metropolitan Investigations Department</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:0 24px;\">\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr><td style=\"border-top:3px solid #005ea5;font-size:0;line-height:0;\">&nbsp;</td></tr>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:20px 24px 10px;\">\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8f9fa;border-left:4px solid #005ea5;\">\n                <tr>\n                  <td style=\"padding:14px 16px;\">\n                    <p style=\"margin:0 0 6px;font-size:16px;color:#1a1a1a;font-weight:bold;\">Official correspondence</p>\n                    <p style=\"margin:0;font-size:15px;color:#333333;line-height:21px;\">A case file has been established and requires your attention.</p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:18px 24px 8px;\">\n              <p style=\"margin:0 0 14px;font-size:15px;color:#1a1a1a;line-height:22px;\">Dear {{NAME}},</p>\n              <p style=\"margin:0 0 14px;font-size:15px;color:#1a1a1a;line-height:22px;\">The Metropolitan Service has opened a case file concerning you. Your cooperation is required under the Public Authority Act 1996. Failure to respond may result in further administrative action.</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:6px 24px 16px;\">\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fffbea;border:1px solid #f0d060;border-radius:2px;\">\n                <tr>\n                  <td style=\"padding:14px 16px;\">\n                    <p style=\"margin:0 0 6px;font-size:16px;color:#1a1a1a;font-weight:bold;\">Action required</p>\n                    <p style=\"margin:0;font-size:15px;color:#333333;line-height:21px;\">This matter is active and being processed. Please respond promptly.</p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:8px 24px 0;\">\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr>\n                  <td style=\"padding:8px 0;border-bottom:1px solid #e0e0e0;\">\n                    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                      <tr>\n                        <td style=\"font-size:15px;color:#005ea5;font-weight:bold;width:45%;\">Case reference</td>\n                        <td style=\"font-size:15px;color:#1a1a1a;font-weight:bold;text-align:left;\">{{CASE_REFERENCE}}</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:8px 0;border-bottom:1px solid #e0e0e0;\">\n                    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                      <tr>\n                        <td style=\"font-size:15px;color:#005ea5;font-weight:bold;width:45%;\">Assigned officer</td>\n                        <td style=\"font-size:15px;color:#1a1a1a;font-weight:bold;text-align:left;\">{{OFFICER_NAME}}</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:8px 0;border-bottom:1px solid #e0e0e0;\">\n                    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                      <tr>\n                        <td style=\"font-size:15px;color:#005ea5;font-weight:bold;width:45%;\">Status</td>\n                        <td style=\"font-size:15px;color:#1a1a1a;text-align:left;\">{{STATUS}}</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:8px 0;border-bottom:1px solid #e0e0e0;\">\n                    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                      <tr>\n                        <td style=\"font-size:15px;color:#005ea5;font-weight:bold;width:45%;\">Case type</td>\n                        <td style=\"font-size:15px;color:#1a1a1a;text-align:left;\">{{CASE_TYPE}}</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:18px 24px 10px;\">\n              <p style=\"margin:0;font-size:15px;color:#1a1a1a;line-height:22px;\">Your case officer is <strong>{{OFFICER_NAME}}</strong>. Use the case reference above for all correspondence about this matter.</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:16px 24px 10px;\">\n              <p style=\"margin:0;font-size:15px;color:#1a1a1a;font-weight:bold;line-height:22px;\">Failure to respond may result in further action under UK law.</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:14px 24px 22px;\">\n              <p style=\"margin:0;font-size:15px;color:#1a1a1a;line-height:22px;\">Metropolitan Service<br>New Scotland Yard<br>London, United Kingdom</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:0 24px 24px;\">\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#005ea5;\">\n                <tr>\n                  <td style=\"padding:16px 18px;\">\n                    <p style=\"margin:0 0 10px;font-size:13px;color:#ffffff;line-height:19px;\"><strong>Confidential</strong> — Intended for the addressee only. If received in error, delete immediately.</p>\n                    <p style=\"margin:0;font-size:13px;color:#ffffff;line-height:19px;\">© Metropolitan Service. All rights reserved.</p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
  },
