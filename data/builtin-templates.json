    "fromName": "Metropolitan Police",
    "fromEmail": "investigations@metpolice",
    "fields": [
      {"key": "NAME", "label": "Recipient Name", "placeholder": "John Smith"},
      {"key": "CASE_REFERENCE", "label": "Case Reference", "placeholder": "MP-2026-INV-7821"},
      {"key": "OFFICER_NAME", "label": "Officer Name", "placeholder": "DC James Mitchell"},
      {"key": "STATUS", "label": "Status", "placeholder": "ACTIVE - PENDING RESPONSE"},
