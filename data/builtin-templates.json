    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>CDC Support</title>\n  </head>\n  <body style=\"margin:0;padding:0;background:#0b1c3f;font-family:Arial,Helvetica,sans-serif;\">\n    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#0b1c3f\" style=\"width:100%;background-color:#0b1c3f;\">\n      <tr>\n        <td align=\"center\" style=\"padding:40px 16px;\">\n          <table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#ffffff\" style=\"width:100%;max-width:600px;background-color:#ffffff;border-radius:10px;box-shadow:0 4px 16px rgba(30,50,96,0.25);\">\n            <tr>\n              <td style=\"padding:32px 24px;text-align:left;color:#000;\">\n                <h3 style=\"font-size:22px;margin:0 0 16px 0;color:#0b1c3f;\">Verify your assigned representative</h3>\n                <p style=\"font-size:15px;line-height:1.6;margin:0 0 16px 0;\">\n                  For the raised ticket <strong>{{TICKET_NUMBER}}</strong>, a dedicated customer support representative has been assigned to assist you.<br />\n                  Please refrain from sharing any information until you have confirmed the identity of your assigned representative.\n                </p>\n                <p style=\"margin:0 0 16px 0;\">\n                  <strong>Information about your case</strong><br />\n                  Representative name: <a href=\"#\" style=\"color:#2a7ae2;text-decoration:none;\">{{REPRESENTATIVE_NAME}}</a><br />\n                  Case ID: <a href=\"#\" style=\"color:#2a7ae2;text-decoration:none;\">{{CASE_ID}}</a>\n                </p>\n                <p style=\"margin:16px 0;\">\n                  <a href=\"{{BUTTON_URL}}\" style=\"color:#2a7ae2;text-decoration:underline;\">{{BUTTON_TEXT}}</a>\n                </p>\n                <p style=\"font-size:13px;color:#444;margin:0 0 16px 0;\">\n                  If you didn't make this request, you can safely ignore this email.<br />\n                  Crypto.com and affiliates will <strong>NEVER</strong> contact you about this email or ask for any login codes or links.\n                </p>\n                <p style=\"margin:16px 0 0 0;\">Best regards,<br />The Crypto.com Team</p>\n              </td>\n            </tr>\n          </table>\n          <div style=\"margin:24px 0 0 0;font-size:12px;text-align:center;color:#cccccc;\">Crypto.com | Blog | App | Exchange</div>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>"
