  {
    "id": "nypd",
    "name": "NYPD Investigation Notice",
    "service": "NYPD",
    "category": "law-enforcement",
    "subject": "Investigation Notice - Case {{CASE_REFERENCE}}",
    "fromName": "NYPD - New York Police Department",
    "fromEmail": "investigations@nypd",
    "fields": [
      {"key": "RECIPIENT_NAME", "label": "Recipient Name", "placeholder": "John Smith"},
      {"key": "CASE_REFERENCE", "label": "Case Reference", "placeholder": "NYPD-2026-48271"},
      {"key": "REPRESENTATIVE_NAME", "label": "Officer Name", "placeholder": "Det. Michael Johnson"}
    ],
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>NYPD Notice</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#f4f4f4;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#f4f4f4;\">\n    <tr>\n      <td align=\"center\" style=\"padding:20px 10px;\">\n        <table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:600px;width:100%;background-color:#ffffff;border:1px solid #dddddd;\">\n          <tr>\n            <td style=\"background-color:#003366;padding:20px;text-align:center;\">\n              <img src=\"cid:nypdlogo\" alt=\"NYPD\" style=\"height:60px;margin-bottom:10px;\">\n              <h1 style=\"color:#ffffff;margin:0;font-size:22px;letter-spacing:1px;\">INVESTIGATION NOTICE</h1>\n              <p style=\"color:#cccccc;margin:8px 0 0 0;font-size:13px;\">New York Police Department - Mandatory Compliance Required</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:20px 24px 0 24px;\">\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#fff3cd;border:1px solid #ffc107;\">\n                <tr>\n                  <td style=\"padding:12px;font-size:13px;color:#856404;\">\n                    <strong>OFFICIAL CORRESPONDENCE - NEW YORK POLICE DEPARTMENT</strong><br>\n                    This correspondence is issued pursuant to the New York State law. A case file has been established and requires your attention. Your response is required.\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:20px 24px;color:#333333;font-size:14px;line-height:1.6;\">\n              <p style=\"margin-top:0;\"><strong>{{RECIPIENT_NAME}}</strong>,</p>\n              <p>This letter serves as formal notification that the New York Police Department (NYPD) has established a case file that requires your attention. This correspondence represents an official request for your participation in this administrative process.</p>\n              <p><strong>A case file has been established concerning matters that need your immediate attention. Your cooperation is required.</strong></p>\n              <h2 style=\"color:#003366;font-size:16px;margin:24px 0 12px 0;border-bottom:2px solid #003366;padding-bottom:4px;\">ONGOING INVESTIGATION DETAILS</h2>\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"8\" border=\"0\" style=\"border-collapse:collapse;margin:16px 0;font-size:13px;\">\n                <tr style=\"background-color:#e9ecef;\">\n                  <td style=\"border:1px solid #ced4da;font-weight:bold;width:40%;\">Case Reference Number:</td>\n                  <td style=\"border:1px solid #ced4da;\"><strong>{{CASE_REFERENCE}}</strong></td>\n                </tr>\n                <tr>\n                  <td style=\"border:1px solid #ced4da;font-weight:bold;\">Assigned Officer:</td>\n                  <td style=\"border:1px solid #ced4da;\"><strong>{{REPRESENTATIVE_NAME}}</strong></td>\n                </tr>\n                <tr style=\"background-color:#e9ecef;\">\n                  <td style=\"border:1px solid #ced4da;font-weight:bold;\">Case Status:</td>\n                  <td style=\"border:1px solid #ced4da;\">ACTIVE - IN PROGRESS</td>\n                </tr>\n              </table>\n              <p><strong>Failure to respond may result in further administrative action.</strong></p>\n              <hr style=\"border:none;border-top:1px solid #dddddd;margin:20px 0;\">\n              <p style=\"margin-bottom:0;\">New York Police Department<br>Law Enforcement Agency<br>New York, United States</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"background-color:#003366;padding:16px 24px;text-align:center;color:#ffffff;font-size:12px;\">\n              <div style=\"font-weight:bold;margin-bottom:8px;\">CONFIDENTIALITY & SECURITY</div>\n              <p style=\"margin:0;\">This email is confidential and intended solely for the addressee.</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
  },
