    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>{{SUBJECT}}</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#eef0f3;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#eef0f3;\">\n    <tr>\n      <td align=\"center\" style=\"padding:26px 14px;\">\n        <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;background:#ffffff;max-width:600px;border-radius:8px;border:1px solid #dfe3e8;\">\n          <tr>\n            <td align=\"center\" style=\"padding:24px 32px;border-bottom:1px solid #e8ecf0;\">\n              <img src=\"cid:metlogo\" alt=\"Metropolitan Police\" style=\"height:50px;margin-bottom:10px;\">\n              <h2 style=\"margin:0;color:#003366;\">Metropolitan Police</h2>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:26px 34px 10px;\">\n              <h1 style=\"margin:0 0 16px;font-size:22px;color:#1a1a2e;font-weight:700;\">{{SUBJECT}}</h1>\n              <p style=\"font-size:15px;color:#333333;margin:0 0 14px;line-height:22px;\">Your Crime Reference number matches an account investigation that has been opened by the Metropolitan Police. Please confirm the details below during any contact.</p>\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f6f8fa;border:1px solid #e6eaef;border-radius:6px;margin:16px 0;\">\n                <tr>\n                  <td style=\"padding:10px 14px;font-size:13px;color:#5f6b7a;border-bottom:1px solid #e6eaef;width:52%;\">Crime Reference</td>\n                  <td style=\"font-size:14px;color:#111a24;padding:10px 14px;font-weight:600;border-bottom:1px solid #e6eaef;text-align:right;\">{{CRIME_REFERENCE}}</td>\n                </tr>\n                <tr>\n                  <td style=\"padding:10px 14px;font-size:13px;color:#5f6b7a;border-bottom:1px solid #e6eaef;width:52%;\">Officer</td>\n                  <td style=\"color:#111a24;padding:10px 14px;text-align:right;font-weight:600;font-size:14px;border-bottom:1px solid #e6eaef;\">{{OFFICER_NAME}}</td>\n                </tr>\n                <tr>\n                  <td style=\"width:52%;color:#5f6b7a;font-size:13px;border-bottom:1px solid #e6eaef;padding:10px 14px;\">Badge No.</td>\n                  <td style=\"color:#111a24;font-weight:600;font-size:14px;border-bottom:1px solid #e6eaef;text-align:right;padding:10px 14px;\">{{BADGE_NUMBER}}</td>\n                </tr>\n                <tr>\n                  <td style=\"border-bottom:1px solid #e6eaef;padding:10px 14px;color:#5f6b7a;font-size:13px;width:52%;\">Call Date</td>\n                  <td style=\"text-align:right;padding:10px 14px;font-weight:600;border-bottom:1px solid #e6eaef;font-size:14px;color:#111a24;\">{{CALL_DATE}}</td>\n                </tr>\n              </table>\n              <p style=\"line-height:22px;margin:0 0 14px;font-size:14px;color:#333333;\">Please have your reference number to hand if an officer contacts you. This email is a copy of an ongoing investigation.</p>\n            </td>\n          </tr>\n          <tr>\n            <td align=\"left\" style=\"font-size:11px;border-top:1px solid #e8ecf0;color:#777777;padding:20px 32px 28px;line-height:18px;\">This is an official notification from Metropolitan Police. This mailbox is not monitored.<br>© 2026. All rights reserved.</td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
  },
  {
    "id": "metpolice2",
    "name": "Metropolitan Police Investigation",
    "service": "Met Police",
    "category": "law-enforcement",
